# CẤU HÌNH GOOGLE SHEETS CHO THE ECHO AWARDS
# Cách 1: Sử dụng Google Apps Script Web App (Khuyên dùng - 1 phút thiết lập)
# Mở Google Sheet > Extensions > Apps Script > Dán mã từ `src/modules/google-sheets/googleAppsScriptTemplate.js`
# Deploy as Web App (Who has access: Anyone) và dán URL vào dưới đây:
GOOGLE_SHEET_WEBAPP_URL="https://script.google.com/macros/s/AKfycbxYOUR_SCRIPT_ID_HERE/exec"

# Cách 2: (Tùy chọn) Google Service Account
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID="your_spreadsheet_id_here"
